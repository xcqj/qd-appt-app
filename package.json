    "@resvg/resvg-js": "2.6.2",
    "@uni-helper/vite-plugin-uni-components": "^0.3.4",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
