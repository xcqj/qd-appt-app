{
  "name": "qd-appt-app",
  "version": "0.1.0",
  "private": true,
  "description": "号源预约系统 · 移动端（患者端 + 分诊台）技术演示，全部虚构数据，不提供医疗服务",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:h5": "uni -p h5",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-wsl": "UNI_OUTPUT_DIR=${APPT_MP_OUT_DIR:-/mnt/d/programming/project/appt-app} VITE_APP_BASE_API=${APPT_MP_BASE_API:-http://192.168.0.108:18082} uni -p mp-weixin",
    "build:h5": "uni build -p h5",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "fmt": "oxfmt .",
    "brand:gen": "node scripts/gen-brand-assets.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
