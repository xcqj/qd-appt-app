    "@noble/ciphers": "^2.4.0",
    "@wot-ui/ui": "^2.3.2",
    "dayjs": "^1.11.13",
    "jsencrypt": "^3.5.4",
    "pinia": "^2.3.1",
    "uqrcodejs": "^4.0.7",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
