# 号源 QueueDepth · 患者端 H5 nginx 模板（S14）
#
# 只有 ${APPT_API_UPSTREAM} 会在容器启动时被替换（NGINX_ENVSUBST_FILTER=^APPT_）。

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    # 接口反代：构建期 VITE_APP_BASE_API=/dev-api，转发时剥掉该前缀
    location /dev-api/ {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 120s;
        proxy_pass ${APPT_API_UPSTREAM}/;
    }

    # H5 为 hash 路由，直接命中 index.html；这里仍做兜底，便于将来切 history 模式
    location / {
        try_files $uri $uri/ /index.html;
    }
}
