# 号源 QueueDepth · 移动端（H5 / 小程序）环境变量模板（S14）
#
# 分三类：
#   A. 构建期（VITE_*）：打包写入产物，改了要重新 build
#   B. 开发期：vite 代理与小程序产物目录
#   C. 运行期（APPT_*）：仅 H5 容器用，nginx 模板注入后端地址
#
# 取值位置：`src/utils/request.ts`（BASE_URL / CLIENT_ID）、`vite.config.ts`（代理）、
#           `docker/nginx/default.conf.template`（APPT_API_UPSTREAM）。

# ---------------------------------------------------------------- A. 构建期
# 请求前缀。H5 容器固定 /dev-api（nginx 剥前缀反代）；小程序端必须为空串 + 已备案 HTTPS 域名
# 生效位置：src/utils/request.ts `const BASE_URL = import.meta.env.VITE_APP_BASE_API || ''`
VITE_APP_BASE_API=/dev-api

# app 客户端 id（sys_client.client_key='app' 的 client_id；**不是**后台的 pc 客户端）
# 用错表现为登录 403 或「当前客户端未授权访问该接口路径」
VITE_APP_CLIENT_ID=428a8310cd442757ae699df5d894f051

# 登录加密开关与 RSA 公钥（仅用于 /auth/login 的 encrypt-key 头；私钥绝不在前端）
VITE_APP_ENCRYPT=true
VITE_APP_RSA_PUBLIC_KEY=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDvEDuRIOM3oZPWj9Ukoc5pQklR4PFH6/clnjeFqjDLIgDyQvjxhgqAZQA+E9eD6qu6FsXPmK8djcL+nh3cFHz4pX473jDvO3Sve+8yL3VRQ0n2pRgQ2a01MJsy+WwTZCBYWf0VnLRIvANUoWQgy9vz94q7Va44dg7A1/3ICf+xAwIDAQAB

# ---------------------------------------------------------------- B. 开发期（pnpm dev:h5）
# H5 dev server 端口固定 8084（vite.config.ts 写死，避开 8082/8083）
VITE_PROXY_TARGET=http://127.0.0.1:8082

# 小程序产物输出目录（Windows 侧路径；`pnpm dev:mp-wsl` 读）
APPT_MP_OUT_DIR=/mnt/d/programming/project/appt-app

# 小程序请求地址（不走 vite 代理，必须是绝对地址）
APPT_MP_BASE_API=http://192.168.0.108:18082

# ---------------------------------------------------------------- C. 运行期（H5 容器）
# 后端上游地址；默认值只在 compose 网络内可用。独立 docker run 时改成宿主机可达地址
# 生效位置：docker/nginx/default.conf.template 的 `proxy_pass ${APPT_API_UPSTREAM}/`
APPT_API_UPSTREAM=http://api:8082
